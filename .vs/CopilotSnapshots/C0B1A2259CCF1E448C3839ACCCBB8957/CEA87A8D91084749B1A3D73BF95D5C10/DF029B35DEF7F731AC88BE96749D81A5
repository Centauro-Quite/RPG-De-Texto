const std::string path = "Saves\\save.txt";
bool Saves::checarSave(const std::string nome)
{
	if (std::filesystem::exists(path)) {
		return true;
	}
	else {
		return false;
	}
	return false;
}


 
Saves::Saves()
{
}

void Saves::Salvar(const StatusPlayer& basestruct, const std::map<int, Ataques>& listaAtaques, const inventario& mochila)
{
    std::ofstream Save (path, std::ios::out);
    Save << (basestruct.Nome) << '\n';
    Save << (basestruct.HPS) << '\n';
    Save << (basestruct.MPS) << '\n';
    Save << (basestruct.ATK) << '\n';
    Save << (basestruct.DFS) << '\n';
    Save << (basestruct.INTS) << "\n";
    Save << (basestruct.LUKS) << "\n";
    Save << (basestruct.LV) << "\n";
    Save << (basestruct.XP) << "\n";
    Save << (basestruct.MaxHP) << "\n";
    Save << (basestruct.MaxMP) << "\n";
    Save << (basestruct.CurMP) << "\n";
    Save << (basestruct.CurATK) << "\n";
    Save << (basestruct.CurDF) << "\n";
    Save << (basestruct.MaxXP) << "\n";
    Save << (basestruct.CurHP) << '\n';

    Save << listaAtaques.size() << '\n';

    for (const auto& [id, ataque] : listaAtaques) {
    
        Save << std::quoted(ataque.Nome) << '\n';
        Save << ataque.dano << '\n';
        Save << id << '\n';
        Save << ataque.mana << '\n';
    }
    Save << mochila.get_tamanho() << '\n';
    Save << mochila.get_flechas() << '\n';
    auto vec = mochila.carregarMochila();
    for (const auto& item : vec) {
        Save << std::quoted(item.Name) << '\n';
        Save << static_cast<int>(item.item) << '\n';
    }
}
std::string Saves::checarexiste() {
    std::ifstream Save(path);
    if (Save.is_open()) {
        std::string a;Save >> a;
        return a;
    }
    return std::string{};
}

void Saves::carregar(StatusPlayer& status, std::map <int, Ataques>& ataques, inventario& mochila)
{
    std::ifstream Save(path);

    if (!Save) {
        return;
    }

    // Nome está na primeira linha e pode conter espaços.
    std::getline(Save, status.Nome);

    Save >> status.HPS
        >> status.MPS
        >> status.ATK
        >> status.DFS
        >> status.INTS
        >> status.LUKS
        >> status.LV
        >> status.XP
        >> status.MaxHP
        >> status.MaxMP
        >> status.CurMP
        >> status.CurATK
        >> status.CurDF
        >> status.MaxXP
        >> status.CurHP;

    std::size_t quantidadeAtaques;
    Save >> quantidadeAtaques;

    ataques.clear();

    for (std::size_t i = 0; i < quantidadeAtaques; ++i) {
        Ataques ataque;
        int id;

        Save >> std::quoted(ataque.Nome)
            >> ataque.dano
            >> id
            >> ataque.mana;

        ataques[id] = ataque;
    }
    std::size_t quantidadem;
    Save >> quantidadem;
    int flechas;
    Save >> flechas;

    std::vector<Coisas> newVec;
    newVec.reserve(quantidadem);

    for (std::size_t i = 0; i < quantidadem; ++i) {
        int itemInt;
        Save >> itemInt;
        Itens item = static_cast<Itens>(itemInt);

        switch (item) {
        case Itens::Flecha: newVec.push_back(Flecha); break;
        case Itens::Anel_Iniciante: newVec.push_back(Anel_Iniciante); break;
        case Itens::Arco_Iniciante: newVec.push_back(Arco_Iniciante); break;
        case Itens::Armadura_Inicial: newVec.push_back(Armadura_Inicial); break;
        case Itens::Espada_Inicial: newVec.push_back(Espada_Inicial); break;
        case Itens::Pocao: newVec.push_back(Pocao); break;
        case Itens::Maca: newVec.push_back(Maca); break;
        case Itens::Armadura_La: newVec.push_back(Armadura_La_Item); break;
        case Itens::Espada_Cobre: newVec.push_back(Espada_Cobre_Item); break;
        case Itens::Arco_Madeira: newVec.push_back(Arco_Madeira_Item); break;
        case Itens::Espada_Duas_Maos: newVec.push_back(Espada_Duas_Maos_Item); break;
        case Itens::Espada_Ferro: newVec.push_back(Espada_Ferro_Item); break;
        case Itens::Armadura_Ferro: newVec.push_back(Armadura_Ferro_Item); break;
        case Itens::Maca_Coragem: newVec.push_back(Maca_Coragem_Item); break;
        case Itens::Pocao_Pureza: newVec.push_back(Pocao_Pureza_Item); break;
        default: newVec.push_back(NadaItem); break;
        }
    }

    mochila.setMochila(newVec, static_cast<int>(quantidadem), flechas);

}
 

