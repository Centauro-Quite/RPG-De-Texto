void Base::recuperarMP(int MP)
{
    CurMP += MP;
    if (CurMP > MaxMP) {
        CurMP = MaxMP;
    }
}
void Base::curar(int cura)
{
    std::cout << "Sua vida esta " << CurHP << '\n';
    CurHP += cura;
    if (CurHP > MaxHP) {
        CurHP = MaxHP;
    }

    std::cout << "curou para:" << CurHP << '\n';
    return;
}


