}
void Base::carregar() {
	Saves carregar;
	auto status = Status();
	carregar.carregar(status, ListadeAtaqueMap, Mochila);
	HPS = status.HPS;
	MPS = status.MPS;
	ATKS = status.ATK;
	DFS = status.DFS;
	INTS = status.INTS;
	LUKS = status.LUKS;
	LV = status.LV;
	XP = status.XP;
	MaxHP = status.MaxHP;
	MaxMP = status.MaxMP;
	CurMP = status.CurMP;
	CurATK = status.CurATK;
	CurDF = status.CurDF;
	MaxXP = status.MaxXP;
	CurHP = status.CurHP;
	Nome = status.Nome;

	// limpar todos os valores dentro de 'status' após copiar para o objeto Base
	status = StatusPlayer{};
}

